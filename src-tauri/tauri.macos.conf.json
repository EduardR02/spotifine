{
  "app": {
    "windows": [
      {
        "title": "Spotifine",
        "visible": false,
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "backgroundColor": "#121212",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "bun run build && bun run build:engine && codesign --force --sign - target/release/PlaybackEngine"
  },
  "bundle": {
    "targets": ["app"],
    "resources": {
      "../target/release/PlaybackEngine": "PlaybackEngine"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
